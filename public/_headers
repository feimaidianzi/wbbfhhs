# Cloudflare Pages cache headers
# Hashed assets (Vite output) — safe to cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static images / icons in /public — cache 30 days, allow revalidation
/*.png
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000
/*.ico
  Cache-Control: public, max-age=2592000

# Fonts
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Service worker — must always revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# HTML — short cache, must revalidate (so users get new builds)
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
